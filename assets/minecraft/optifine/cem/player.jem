{
	"credit": "Made with Blockbench",
	"textureSize": [64, 64],
	"models": [
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, -24, 0],
			"boxes": [
				{
					"coordinates": [-4, 24, -4, 8, 8, 8],
					"uvNorth": [8, 8, 16, 16],
					"uvEast": [0, 8, 8, 16],
					"uvSouth": [24, 8, 32, 16],
					"uvWest": [16, 8, 24, 16],
					"uvUp": [16, 8, 8, 0],
					"uvDown": [24, 0, 16, 8]
				}
			],
			"animations": [
				{}
			]
		},
		{
			"part": "body",
			"id": "body",
			"invertAxis": "xy",
			"translate": [0, -24, 0],
			"boxes": [
				{
					"coordinates": [-4, 12, -2, 8, 12, 4],
					"uvNorth": [20, 20, 28, 32],
					"uvEast": [16, 20, 20, 32],
					"uvSouth": [32, 20, 40, 32],
					"uvWest": [28, 20, 32, 32],
					"uvUp": [28, 20, 20, 16],
					"uvDown": [36, 16, 28, 20]
				}
			],
			"animations": [
				{
					"var.r": "(pi * random(id) * 2) + (limb_speed / 20)",
					"var.b": "age / (11 - random(id) * 2)",
					"var.ls": "limb_swing / 2",
					"var.jump": "if(!is_on_ground, min(1, var.jump + 0.2 * frame_time * 50), max(0, var.jump - 0.2 * frame_time * 100))",
					"var.nov1": "clamp(-5.6 + cos(-pi / 6 + var.r + age   / 80) *  6, 0, 1) * clamp(2 - limb_speed * 4, 0, 1)",
					"var.nov2": "clamp( -39 + cos(-pi / 4 + var.r + var.b / 20) * 40, 0, 1) * clamp(1 - limb_speed * 2, 0, 1)"
				},
				{
					"head.rx": "torad(head_pitch)",
					"head.ry": "torad(head_yaw)",
					"head.tx": "sin(torad(45) + var.ls) / 10 * limb_speed",
					"head.ty": "-0.3 - sin(torad(if(limb_speed > 0.9, -45, 45)) + var.ls * 2) * limb_speed/2 + sin(var.r + var.b)/10 + if(is_sneaking && is_on_ground, 3, 0) + if(is_riding, 1, 0)",
					"head.tz": "-1 * (limb_speed / 10) * move_forward - sin(var.r + var.b)/6 - cos(var.ls * 2)/2 * clamp(limb_speed, 0, 1) - if(is_sneaking && is_on_ground, 1.5, 0)"
				},
				{
					"body.ry": "torad(-7.5 * -sin(var.ls) / 4 * limb_speed * clamp(-1 + limb_speed * 2, 0, 1)) + torad(head_yaw)/3",
					"body.rz": "head.rz",
					"body.tx": "head.tx",
					"body.ty": "head.ty - if(is_sneaking && is_on_ground, 1, 0)",
					"body.tz": "head.tz + limb_speed/6"
				},
				{
					"right_arm.rx": "torad(head_pitch)/10 + if(is_riding, torad(-45), -sin(var.ls) * limb_speed/if(limb_speed > 0.9, 1, 2) * if(move_forward > 0, 1, -1) + torad(head_yaw)/10) + (-sin(-pi / 3 + var.r + var.b + sin(var.r + var.b)) / 6 ) * var.nov2 - sin(pi*swing_progress)",
					"left_arm.rx": "torad(head_pitch)/10 + if(is_riding, torad(-45),  sin(var.ls) * limb_speed/if(limb_speed > 0.9, 1, 2) * if(move_forward > 0, 1, -1) - torad(head_yaw)/10) + (-sin(-pi / 3 + var.r + var.b + sin(var.r + var.b)) / 6 ) * var.nov2 + sin(pi*swing_progress)/6",
					"right_arm.ry": "if(!is_riding, -torad(5),  cos(var.r + var.b)/30 + torad(-10)                            )",
					"left_arm.ry": "if(!is_riding,  torad(5), -cos(var.r + var.b)/30 + torad( 10) + sin(pi*swing_progress)/10)",
					"right_arm.rz": "sin(pi*2*swing_progress)/2 - torad(head_pitch)/20 + torad( 8 +   2 * var.pose) + torad(var.jump * 10) + sin(-pi+torad(90)*swing_progress*2)",
					"left_arm.rz": "                             torad(head_pitch)/20 + torad(-8 + 0.5 * var.pose) - torad(var.jump * 10)",
					"right_arm.tx": "body.tx - 5 + (-sin(var.ls)/2 * limb_speed) * torad(head_yaw/4) * clamp(1 - limb_speed * 2, 0, 1) - 0.3",
					"left_arm.tx": "body.tx + 5 + ( sin(var.ls)/2 * limb_speed) * torad(head_yaw/4) * clamp(1 - limb_speed * 2, 0, 1) + 0.3",
					"right_arm.ty": "body.ty + 1.4 + sin(var.r + var.b - torad(60))/7 + if(is_riding, 1, 0)",
					"left_arm.ty": "body.ty + 1.4 + sin(var.r + var.b - torad(60))/7 + if(is_riding, 1, 0)",
					"right_arm.tz": "-sin(var.r + var.b)/6 + torad(head_yaw) * clamp(1 - limb_speed * 2, 0, 1) + if(is_riding, -2, 0) + var.nov2 + sin(pi*swing_progress/2)",
					"left_arm.tz": "-sin(var.r + var.b)/6 - torad(head_yaw) * clamp(1 - limb_speed * 2, 0, 1) + if(is_riding, -2, 0) + var.nov2 + sin(pi*swing_progress/2)"
				},
				{
					"right_leg.rx": "if(is_riding, torad(-75), torad(10) * limb_speed + if(is_riding, torad(-80), clamp(torad(-5) + limb_speed, torad(- 5), 0) + (torad(2) + sin(torad( 2) + var.b)/100) + ( sin(var.ls))/if(limb_speed > 0.9, 0.8, 1.5) * (limb_speed * if(move_forward > 0, 1, -1))) + clamp(-torad(head_yaw)/30, -torad(5), torad(5)) + if(limb_speed > 0.9, 0, sin(var.jump / 3)) )",
					"left_leg.rx": " if(is_riding, torad(-75), torad(10) * limb_speed + if(is_riding, torad(-80), clamp(torad( 5) - limb_speed, 0,   torad(5)) + (torad(2) + sin(torad(-2) + var.b)/100) + (-sin(var.ls))/if(limb_speed > 0.9, 0.8, 1.5) * (limb_speed * if(move_forward > 0, 1, -1))) + clamp( torad(head_yaw)/40, -torad(5), torad(5)) + if(limb_speed > 0.9, 0, sin(var.jump / 3)) )",
					"right_leg.ry": "if(is_riding, torad( 20), if(var.jump != 0, if(limb_speed > 0.9, 0,  torad(var.jump) *  5), torad(  5) * (1 - limb_speed) - torad(var.jump * 5) )  )",
					"left_leg.ry": " if(is_riding, torad(-20), if(var.jump != 0, if(limb_speed > 0.9, 0, -torad(var.jump) * 10), torad(-20) * (1 - limb_speed) + torad(var.jump * 15))  )",
					"right_leg.rz": "if(is_riding, 0, clamp(torad( 2.5) - limb_speed, 0, torad(2.5)) * if(is_sneaking && is_on_ground, 0, 1) + torad( 3) ) + sin(var.ls)/16 * limb_speed/1.2",
					"left_leg.rz": " if(is_riding, 0, clamp(torad(-3) + limb_speed, torad(-5), 0 ) * if(is_sneaking && is_on_ground, 0, 1) + torad(-3) ) + sin(var.ls)/16 * limb_speed/1.2",
					"right_leg.tx": "-2 + clamp(-0.25 + limb_speed, -0.25, 0)",
					"left_leg.tx": "  2 + clamp( 0.25 - limb_speed, 0, 0.25 )",
					"right_leg.ty": "if(is_riding, 13, 0.1 + clamp(12 + cos(if(limb_speed > 0.9, 0, torad(-30)) + var.ls) * 2 * clamp(limb_speed * 2, 0, 2) + clamp(-1 + limb_speed * 1.5, 0, 1) , 0, 12.2) + if(is_riding, -1, 0) + clamp( (-sin(var.ls) + body.ty) * clamp(-cos(limb_speed*pi), 0, 1), -4, 0) - if(limb_speed > 0.9, 0, var.jump)  )",
					"left_leg.ty": " if(is_riding, 13, 0.1 + clamp(12 - cos(if(limb_speed > 0.9, 0, torad(-30)) + var.ls) * 2 * clamp(limb_speed * 2, 0, 2) + clamp(-1 + limb_speed * 1.5, 0, 1) , 0, 12.2) + if(is_riding, -1, 0) + clamp( ( sin(var.ls) + body.ty) * clamp(-cos(limb_speed*pi), 0, 1), -4, 0) - if(limb_speed > 0.9, 0, var.jump)  )",
					"right_leg.tz": "if(is_riding, -2.5, -1 + clamp(3 + cos(var.ls * 2)/2 * clamp(limb_speed * 3, 0, 1), -6, 1) * 1.2 + if(is_riding, -2, 0 + clamp( torad(head_yaw)/2, -pi/4, pi/4) - sin(torad( 20) + var.b)/8) + clamp(-1.5 + limb_speed * 6, -1.5, 0) + if(is_sneaking && is_on_ground, 2.5, 0) - if(limb_speed > 0.9, 0, if(!is_riding, var.jump, 0))  )",
					"left_leg.tz": " if(is_riding, -2.5, -1 + clamp(3 - cos(var.ls * 2)/2 * clamp(limb_speed * 3, 0, 1), -6, 1) * 1.2 + if(is_riding, -2, 0 + clamp(-torad(head_yaw)/2, -pi/4, pi/4) - sin(torad(-20) + var.b)/8) + clamp(-0.5 + limb_speed * 2, -0.5, 0) + if(is_sneaking && is_on_ground, 2.5, 0) - if(limb_speed > 0.9, 0, if(!is_riding, var.jump, 0))  )"
				},
				{
					"cloak.rx": "body.rx - if(is_sneaking && is_on_ground, 0.5, 0)",
					"cloak.ry": "body.ry",
					"cloak.rz": "body.rz",
					"cloak.tx": "-body.tx",
					"cloak.ty": "body.ty - if(is_sneaking && is_on_ground, 2.5, 0)",
					"cloak.tz": "-1 + if(is_sneaking && is_on_ground, 3, 0)"
				},
				{
					"headwear.tx": "head.tx",
					"headwear.ty": "head.ty",
					"headwear.tz": "head.tz",
					"headwear.rx": "head.rx",
					"headwear.ry": "head.ry",
					"headwear.rz": "head.rz",
					"jacket.tx": "body.tx",
